            "index": 0
          }
        ]
      ]
    },
    "Validate Human Approval": {
      "main": [
        [
          {
            "node": "Schedule Approved Publication",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
