{
  "name": "YT Music - Approval Gated Publish",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "/api/v1/publications/approve-and-schedule",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "approval-webhook",
      "name": "Human Approval Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "replace-after-import"
    },
    {
      "parameters": {
        "jsCode": "const p=$input.first().json.body ?? $input.first().json;\nif(p.approved!==true) throw new Error('Publication denied: explicit human approval required.');\nif(!p.videoId || !p.approvalId || !p.channelId) throw new Error('videoId, approvalId and channelId required.');\nreturn [{json:{videoId:String(p.videoId),approvalId:String(p.approvalId),channelId:String(p.channelId),publishAt:p.publishAt??null,approved:true,approvedAt:new Date().toISOString()}}];"
      },
      "id": "validate-human-approval",
      "name": "Validate Human Approval",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.API_BASE_URL + '/api/v1/publications/approve-and-schedule'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-workflow-secret",
              "value": "={{$env.N8N_WEBHOOK_SECRET}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{$json}}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "schedule-approved-publication",
      "name": "Schedule Approved Publication",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        740,
        300
      ]
    }
  ],
  "connections": {
    "Human Approval Webhook": {
      "main": [
        [
          {
