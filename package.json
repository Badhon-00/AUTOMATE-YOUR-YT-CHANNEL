{
  "name": "automate-your-yt-channel",
  "version": "0.1.0",
  "private": true,
  "description": "Rights-aware AI-assisted YouTube music production and channel management",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "dev": "tsx watch apps/api/src/server.ts",
    "build": "tsc -p apps/api/tsconfig.json",
    "start": "node apps/api/dist/server.js",
    "typecheck": "tsc --noEmit -p apps/api/tsconfig.json"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
